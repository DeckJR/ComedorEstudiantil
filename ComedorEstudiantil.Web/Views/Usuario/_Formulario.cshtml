@model ComedorEstudiantil.Application.DTOs.UsuarioFormularioDTO

<input asp-for="IdUsuario" type="hidden" />
<input asp-for="IdRolEstudiante" type="hidden" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autocomplete="given-name" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Apellidos" class="form-label"></label>
        <input asp-for="Apellidos" class="form-control" autocomplete="family-name" />
        <span asp-validation-for="Apellidos" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Identificacion" class="form-label"></label>
        <input asp-for="Identificacion" class="form-control" />
        <span asp-validation-for="Identificacion" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" autocomplete="email" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="IdRol" class="form-label"></label>

    <select asp-for="IdRol"
            class="form-select"
            id="selectorRol"
            data-id-rol-estudiante="@Model.IdRolEstudiante">
        <option value="">Seleccione un rol</option>

        @foreach (var rol in Model.Roles)
        {
            <option value="@rol.Id">@rol.Nombre</option>
        }
    </select>

    <span asp-validation-for="IdRol" class="text-danger"></span>
</div>

@if (Model.IdUsuario == 0)
{
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Contrasena" class="form-label"></label>
            <input asp-for="Contrasena"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="Contrasena" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="ConfirmarContrasena" class="form-label"></label>
            <input asp-for="ConfirmarContrasena"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmarContrasena"
                  class="text-danger"></span>
        </div>
    </div>
}

<div id="datosEstudiante" class="border rounded p-3 mb-3">
    <h2 class="h5 mb-3">Información del estudiante</h2>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="IdTipoBeneficiario" class="form-label"></label>

            <select asp-for="IdTipoBeneficiario" class="form-select">
                <option value="">Seleccione un tipo</option>

                @foreach (var tipo in Model.TiposBeneficiario)
                {
                    <option value="@tipo.Id">@tipo.Nombre</option>
                }
            </select>

            <span asp-validation-for="IdTipoBeneficiario"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="IdGradoSeccion" class="form-label"></label>

            <select asp-for="IdGradoSeccion" class="form-select">
                <option value="">Sin asignar</option>

                @foreach (var grado in Model.GradosSecciones)
                {
                    <option value="@grado.Id">@grado.Nombre</option>
                }
            </select>

            <span asp-validation-for="IdGradoSeccion"
                  class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="AnioIngreso" class="form-label"></label>

            <input asp-for="AnioIngreso"
                   class="form-control"
                   type="number"
                   min="2000"
                   max="2100" />

            <span asp-validation-for="AnioIngreso"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CodigoAcceso" class="form-label"></label>

            <input asp-for="CodigoAcceso" class="form-control" />

            <span asp-validation-for="CodigoAcceso"
                  class="text-danger"></span>

            <div class="form-text">
                Campo opcional para un futuro código QR o de barras.
            </div>
        </div>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Activo" class="form-check-input" />

    <label asp-for="Activo" class="form-check-label">
        Usuario activo
    </label>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectorRol = document.getElementById("selectorRol");
        const datosEstudiante = document.getElementById("datosEstudiante");

        if (!selectorRol || !datosEstudiante) {
            return;
        }

        const idRolEstudiante = selectorRol.dataset.idRolEstudiante;

        function actualizarDatosEstudiante() {
            const esEstudiante = selectorRol.value === idRolEstudiante;
            datosEstudiante.style.display = esEstudiante ? "block" : "none";
        }

        selectorRol.addEventListener("change", actualizarDatosEstudiante);
        actualizarDatosEstudiante();
    });
</script>