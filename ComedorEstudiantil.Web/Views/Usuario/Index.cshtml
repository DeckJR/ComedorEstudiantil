@model IEnumerable<ComedorEstudiantil.Application.DTOs.UsuarioListaDTO>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                Usuarios
            </h1>

            <p class="text-muted mb-0">
                Administración de usuarios del comedor del colegio.
            </p>
        </div>

        <a asp-controller="Usuario"
           asp-action="Crear"
           class="btn btn-primary">
            Crear usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Código de barras</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Información estudiantil</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    @usuario.Identificacion
                                </td>

                                <td>
                                    <a asp-controller="Usuario"
                                       asp-action="CodigoBarras"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="text-decoration-none">

                                        <img src="@Url.Action(
                                            "ImagenCodigoBarras",
                                            "Usuario",
                                            new
                                            {
                                                id = usuario.IdUsuario
                                            })"
                                             alt="Código de barras de @usuario.NombreCompleto"
                                             style="width: 220px;
                                                    height: 60px;
                                                    object-fit: contain;" />

                                        <div class="text-center">
                                            <code>
                                                @usuario.CodigoBarras
                                            </code>
                                        </div>
                                    </a>
                                </td>

                                <td>
                                    @usuario.NombreCompleto
                                </td>

                                <td>
                                    @usuario.Correo
                                </td>

                                <td>
                                    @usuario.Rol
                                </td>

                                <td>
                                    @if (usuario.Rol == "Estudiante")
                                    {
                                        <div>
                                            <strong>Beneficio:</strong>

                                            @(usuario.TipoBeneficiario ??
                                                "Sin asignar")
                                        </div>

                                        <div>
                                            <strong>Grupo:</strong>

                                            @(usuario.GradoSeccion ??
                                                "Sin asignar")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No aplica
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a asp-controller="Usuario"
                                           asp-action="Editar"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Usuario"
                                           asp-action="RestablecerContrasena"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm btn-outline-warning">
                                            Contraseña
                                        </a>

                                        @if (usuario.Activo)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger boton-estado-usuario"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCambiarEstadoUsuario"
                                                    data-id-usuario="@usuario.IdUsuario"
                                                    data-nombre-usuario="@usuario.NombreCompleto"
                                                    data-identificacion="@usuario.Identificacion"
                                                    data-esta-activo="true">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success boton-estado-usuario"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCambiarEstadoUsuario"
                                                    data-id-usuario="@usuario.IdUsuario"
                                                    data-nombre-usuario="@usuario.NombreCompleto"
                                                    data-identificacion="@usuario.Identificacion"
                                                    data-esta-activo="false">
                                                Activar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">
                                    No existen usuarios registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para activar o desactivar un usuario -->
<div class="modal fade"
     id="modalCambiarEstadoUsuario"
     tabindex="-1"
     aria-labelledby="tituloModalCambiarEstadoUsuario"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-controller="Usuario"
                  asp-action="CambiarEstado"
                  method="post">

                @Html.AntiForgeryToken()

                <input id="idUsuarioCambiarEstado"
                       name="id"
                       type="hidden" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5"
                        id="tituloModalCambiarEstadoUsuario">
                        Cambiar estado del usuario
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p id="mensajeCambiarEstadoUsuario"
                       class="mb-3">
                    </p>

                    <div class="alert alert-light border mb-0">
                        <div class="mb-2">
                            <strong>Usuario:</strong>

                            <span id="nombreUsuarioCambiarEstado"></span>
                        </div>

                        <div>
                            <strong>Identificación:</strong>

                            <span id="identificacionUsuarioCambiarEstado"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Volver
                    </button>

                    <button id="botonConfirmarEstadoUsuario"
                            type="submit"
                            class="btn">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal =
                document.getElementById(
                    "modalCambiarEstadoUsuario");

            const campoId =
                document.getElementById(
                    "idUsuarioCambiarEstado");

            const campoNombre =
                document.getElementById(
                    "nombreUsuarioCambiarEstado");

            const campoIdentificacion =
                document.getElementById(
                    "identificacionUsuarioCambiarEstado");

            const mensaje =
                document.getElementById(
                    "mensajeCambiarEstadoUsuario");

            const botonConfirmar =
                document.getElementById(
                    "botonConfirmarEstadoUsuario");

            if (!modal ||
                !campoId ||
                !campoNombre ||
                !campoIdentificacion ||
                !mensaje ||
                !botonConfirmar) {
                return;
            }

            modal.addEventListener(
                "show.bs.modal",
                function (event) {
                    const boton = event.relatedTarget;

                    if (!boton) {
                        return;
                    }

                    const idUsuario =
                        boton.dataset.idUsuario ?? "";

                    const nombreUsuario =
                        boton.dataset.nombreUsuario ?? "";

                    const identificacion =
                        boton.dataset.identificacion ?? "";

                    const estaActivo =
                        boton.dataset.estaActivo === "true";

                    campoId.value =
                        idUsuario;

                    campoNombre.textContent =
                        nombreUsuario;

                    campoIdentificacion.textContent =
                        identificacion;

                    if (estaActivo) {
                        mensaje.textContent =
                            "¿Desea desactivar este usuario?";

                        botonConfirmar.textContent =
                            "Confirmar desactivación";

                        botonConfirmar.className =
                            "btn btn-danger";
                    }
                    else {
                        mensaje.textContent =
                            "¿Desea activar este usuario?";

                        botonConfirmar.textContent =
                            "Confirmar activación";

                        botonConfirmar.className =
                            "btn btn-success";
                    }
                });
        });
    </script>
}F