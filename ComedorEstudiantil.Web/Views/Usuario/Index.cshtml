@model IEnumerable<ComedorEstudiantil.Application.DTOs.UsuarioListaDTO>

@{
    ViewData["Title"] = "Usuarios";

    bool incluirArchivados =
        ViewData["IncluirArchivados"] is bool valor &&
        valor;
}

<div class="container py-4">
    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                Usuarios
            </h1>

            <p class="text-muted mb-0">
                Administración de usuarios del comedor.
            </p>
        </div>

        <a asp-controller="Usuario"
           asp-action="Crear"
           class="btn btn-primary">
            Crear usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success
                    alert-dismissible fade show"
             role="alert">
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger
                    alert-dismissible fade show"
             role="alert">
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Usuario"
                  asp-action="Index"
                  method="get">
                <div class="form-check form-switch">
                    @if (incluirArchivados)
                    {
                        <input id="incluirArchivados"
                               name="incluirArchivados"
                               value="true"
                               type="checkbox"
                               class="form-check-input"
                               checked
                               onchange="this.form.submit();" />
                    }
                    else
                    {
                        <input id="incluirArchivados"
                               name="incluirArchivados"
                               value="true"
                               type="checkbox"
                               class="form-check-input"
                               onchange="this.form.submit();" />
                    }

                    <label for="incluirArchivados"
                           class="form-check-label">
                        Mostrar también usuarios archivados
                    </label>
                </div>

                <div class="form-text">
                    Los usuarios archivados no pueden iniciar sesión
                    ni utilizar el sistema.
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex
                    justify-content-between
                    align-items-center">
            <strong>
                Usuarios registrados
            </strong>

            <span class="badge bg-secondary">
                @Model.Count()
            </span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped
                              table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Código de barras</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Información estudiantil</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr class="@(!usuario.Activo
                                ? "table-secondary"
                                : string.Empty)">
                                <td>
                                    @usuario.Identificacion
                                </td>

                                <td>
                                    <a asp-controller="Usuario"
                                       asp-action="CodigoBarras"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="text-decoration-none">
                                        <img src="@Url.Action(
                                                  "ImagenCodigoBarras",
                                                  "Usuario",
                                                  new
                                                  {
                                                      id = usuario.IdUsuario
                                                  })"
                                             alt="Código de barras de @usuario.NombreCompleto"
                                             style="width: 220px;
                                                    height: 60px;
                                                    object-fit: contain;" />

                                        <div class="text-center">
                                            <code>
                                                @usuario.CodigoBarras
                                            </code>
                                        </div>
                                    </a>
                                </td>

                                <td>
                                    @usuario.NombreCompleto
                                </td>

                                <td>
                                    @usuario.Correo
                                </td>

                                <td>
                                    @usuario.Rol
                                </td>

                                <td>
                                    @if (usuario.Rol == "Estudiante")
                                    {
                                        <div>
                                            <strong>Beneficio:</strong>
                                            @(usuario.TipoBeneficiario
                                                ?? "Sin asignar")
                                        </div>

                                        <div>
                                            <strong>Grupo:</strong>
                                            @(usuario.GradoSeccion
                                                ?? "Sin asignar")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No aplica
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Archivado
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap
                                                justify-content-end
                                                gap-2">
                                        <a asp-controller="Usuario"
                                           asp-action="Editar"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Usuario"
                                           asp-action="RestablecerContrasena"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm
                                                  btn-outline-warning">
                                            Contraseña
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm @(usuario.Activo
                                                    ? "btn-outline-danger"
                                                    : "btn-outline-success")"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEstadoUsuario"
                                                data-id="@usuario.IdUsuario"
                                                data-nombre="@usuario.NombreCompleto"
                                                data-activo="@usuario.Activo.ToString().ToLowerInvariant()">
                                            @(usuario.Activo
                                                ? "Archivar"
                                                : "Restaurar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center
                                           text-muted py-4">
                                    @if (incluirArchivados)
                                    {
                                        <span>
                                            No existen usuarios registrados.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            No existen usuarios activos.
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalEstadoUsuario"
     tabindex="-1"
     aria-labelledby="tituloModalEstadoUsuario"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Usuario"
                  asp-action="CambiarEstado"
                  method="post">
                @Html.AntiForgeryToken()

                <input id="idUsuarioEstado"
                       name="id"
                       type="hidden" />

                <input name="incluirArchivados"
                       value="@incluirArchivados.ToString().ToLowerInvariant()"
                       type="hidden" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5"
                        id="tituloModalEstadoUsuario">
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p id="mensajeModalEstadoUsuario"
                       class="mb-0">
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Volver
                    </button>

                    <button id="botonConfirmarEstadoUsuario"
                            type="submit"
                            class="btn">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal =
                document.getElementById("modalEstadoUsuario");

            const campoId =
                document.getElementById("idUsuarioEstado");

            const titulo =
                document.getElementById(
                    "tituloModalEstadoUsuario");

            const mensaje =
                document.getElementById(
                    "mensajeModalEstadoUsuario");

            const botonConfirmar =
                document.getElementById(
                    "botonConfirmarEstadoUsuario");

            modal.addEventListener(
                "show.bs.modal",
                function (event) {
                    const boton = event.relatedTarget;
                    const activo =
                        boton.dataset.activo === "true";

                    campoId.value =
                        boton.dataset.id;

                    if (activo) {
                        titulo.textContent =
                            "Archivar usuario";

                        mensaje.textContent =
                            "¿Desea archivar a " +
                            boton.dataset.nombre +
                            "? El usuario dejará de aparecer en el listado principal y no podrá iniciar sesión.";

                        botonConfirmar.textContent =
                            "Archivar";

                        botonConfirmar.className =
                            "btn btn-danger";
                    } else {
                        titulo.textContent =
                            "Restaurar usuario";

                        mensaje.textContent =
                            "¿Desea restaurar a " +
                            boton.dataset.nombre +
                            "? El usuario podrá volver a utilizar el sistema.";

                        botonConfirmar.textContent =
                            "Restaurar";

                        botonConfirmar.className =
                            "btn btn-success";
                    }
                });
        });
    </script>
}