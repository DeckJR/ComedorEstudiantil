@model IEnumerable<ComedorEstudiantil.Application.DTOs.UsuarioListaDTO>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Usuarios</h1>
            <p class="text-muted mb-0">
                Administración de usuarios del comedor estudiantil.
            </p>
        </div>

        <a asp-controller="Usuario"
           asp-action="Crear"
           class="btn btn-primary">
            Crear usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Código de barras</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Información estudiantil</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.Identificacion</td>
                                <td>
                                    <a asp-controller="Usuario"
                                       asp-action="CodigoBarras"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="text-decoration-none">
                                        <img src="@Url.Action(
                  "ImagenCodigoBarras",
                  "Usuario",
                  new { id = usuario.IdUsuario })"
                                             alt="Código de barras de @usuario.NombreCompleto"
                                             style="width: 220px; height: 60px; object-fit: contain;" />

                                        <div class="text-center">
                                            <code>@usuario.CodigoBarras</code>
                                        </div>
                                    </a>
                                </td>
                                <td>@usuario.NombreCompleto</td>
                                <td>@usuario.Correo</td>
                                <td>@usuario.Rol</td>
                                <td>
                                    @if (usuario.Rol == "Estudiante")
                                    {
                                        <div>
                                            <strong>Beneficio:</strong>
                                            @(usuario.TipoBeneficiario ?? "Sin asignar")
                                        </div>

                                        <div>
                                            <strong>Grupo:</strong>
                                            @(usuario.GradoSeccion ?? "Sin asignar")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No aplica
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a asp-controller="Usuario"
                                           asp-action="Editar"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Usuario"
                                           asp-action="RestablecerContrasena"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn btn-sm btn-outline-warning">
                                            Contraseña
                                        </a>

                                        <form asp-controller="Usuario"
                                              asp-action="CambiarEstado"
                                              asp-route-id="@usuario.IdUsuario"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            @if (usuario.Activo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Desea desactivar este usuario?');">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        onclick="return confirm('¿Desea activar este usuario?');">
                                                    Activar
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">
                                    No existen usuarios registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>