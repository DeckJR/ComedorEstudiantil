@model ComedorEstudiantil.Application.DTOs.RestablecerContrasenaDTO

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h1 class="h4 mb-0">
                        Restablecer contraseña
                    </h1>
                </div>

                <div class="card-body">
                    <p>
                        Usuario:
                        <strong>@Model.NombreCompleto</strong>
                    </p>

                    <form asp-controller="Usuario"
                          asp-action="RestablecerContrasena"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="IdUsuario"
                               type="hidden" />

                        <input asp-for="NombreCompleto"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevaContrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="NuevaContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NuevaContrasena"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmarContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmarContrasena"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-warning">
                                Restablecer
                            </button>

                            <a asp-controller="Usuario"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}