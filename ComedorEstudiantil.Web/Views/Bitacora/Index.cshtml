@model ComedorEstudiantil.Application.DTOs.BitacoraConsultaDTO

@{
    ViewData["Title"] = "Bitácora";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Bitácora de auditoría</h1>
        <p class="text-muted mb-0">
            Consulta de operaciones realizadas en el sistema.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Bitacora"
                  asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label asp-for="Filtro.FechaInicio"
                           class="form-label">
                    </label>
                    <input name="FechaInicio"
                           type="date"
                           value="@Model.Filtro.FechaInicio.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label asp-for="Filtro.FechaFin"
                           class="form-label">
                    </label>
                    <input name="FechaFin"
                           type="date"
                           value="@Model.Filtro.FechaFin.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Filtro.Usuario"
                           class="form-label">
                    </label>
                    <input name="Usuario"
                           value="@Model.Filtro.Usuario"
                           class="form-control"
                           placeholder="Nombre o identificación" />
                </div>

                <div class="col-md-2">
                    <label asp-for="Filtro.Accion"
                           class="form-label">
                    </label>
                    <input name="Accion"
                           value="@Model.Filtro.Accion"
                           class="form-control"
                           placeholder="Crear, Editar..." />
                </div>

                <div class="col-md-2">
                    <label asp-for="Filtro.Entidad"
                           class="form-label">
                    </label>
                    <input name="Entidad"
                           value="@Model.Filtro.Entidad"
                           class="form-control"
                           placeholder="Usuario, Menu..." />
                </div>

                <div class="col-md-1">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <strong>Registros</strong>
            <span class="badge bg-secondary">
                @Model.Registros.Count
            </span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha y hora</th>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Entidad</th>
                            <th>Identificador</th>
                            <th>Detalle</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registro in Model.Registros)
                        {
                            <tr>
                                <td>
                                    @registro.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    <div>@registro.NombreUsuario</div>
                                    <small class="text-muted">
                                        @registro.IdentificacionUsuario
                                    </small>
                                </td>
                                <td>@registro.Accion</td>
                                <td>@registro.Entidad</td>
                                <td>
                                    @(registro.IdEntidad?.ToString() ?? "No aplica")
                                </td>
                                <td>@registro.Detalle</td>
                                <td>@registro.IpOrigen</td>
                            </tr>
                        }

                        @if (!Model.Registros.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No existen registros para los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>