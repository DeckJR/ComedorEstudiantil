@model ComedorEstudiantil.Application.DTOs.RegistroEntregaDTO

@{
    ViewData["Title"] = "Registrar entrega";

    bool confirmarRepeticion =
        TempData["ConfirmarRepeticion"] is bool confirmar &&
        confirmar;

    int? idEntregaRepeticion =
        TempData["IdEntregaRepeticion"] is int idEntrega
            ? idEntrega
            : null;

    string nombreRepeticion =
        TempData["NombreRepeticion"]?.ToString()
        ?? string.Empty;

    string identificacionRepeticion =
        TempData["IdentificacionRepeticion"]?.ToString()
        ?? string.Empty;

    string mensajeRepeticion =
        TempData["MensajeRepeticion"]?.ToString()
        ?? string.Empty;

    string origenRepeticion =
        TempData["OrigenRepeticion"]?.ToString()
        ?? string.Empty;

    string identificacionBusqueda =
        TempData["IdentificacionBusqueda"]?.ToString()
        ?? string.Empty;

    int cantidadRepeticiones =
        TempData["CantidadRepeticiones"] is int cantidad
            ? cantidad
            : 0;
}

<div class="container py-4">
    <h1 class="h3 mb-4">Registrar entrega</h1>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <strong>Operación realizada correctamente.</strong>
            <div>@TempData["MensajeExito"]</div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show"
             role="alert">
            <strong>No se pudo completar la operación.</strong>
            <div>@TempData["MensajeError"]</div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (confirmarRepeticion &&
    idEntregaRepeticion.HasValue)
    {
        <div class="card border-warning shadow-sm mb-4">
            <div class="card-header bg-warning">
                <strong>Confirmar repetición de comida</strong>
            </div>

            <div class="card-body">
                <h2 class="h5 mb-3">
                    @nombreRepeticion
                </h2>

                <p class="mb-1">
                    Cédula:
                    <strong>@identificacionRepeticion</strong>
                </p>

                <p class="mb-1">
                    Repeticiones registradas:
                    <strong>@cantidadRepeticiones</strong>
                </p>

                <p class="mt-3 mb-3">
                    @mensajeRepeticion
                </p>

                @if (origenRepeticion == "CodigoBarras" &&
               Model.IdMenuSeleccionado.HasValue)
                {
                    <form asp-controller="Entrega"
                          asp-action="RegistrarRepeticionCodigoBarras"
                          method="post"
                          class="formulario-repeticion d-inline">
                        @Html.AntiForgeryToken()

                        <input name="idEntrega"
                               value="@idEntregaRepeticion.Value"
                               type="hidden" />

                        <input name="idMenu"
                               value="@Model.IdMenuSeleccionado.Value"
                               type="hidden" />

                        <button type="submit"
                                class="btn btn-warning">
                            Confirmar repetición número @(cantidadRepeticiones + 1)
                        </button>
                    </form>

                    <a asp-controller="Entrega"
                       asp-action="Registrar"
                       asp-route-idMenu="@Model.IdMenuSeleccionado.Value"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                }
                else
                {
                    <form asp-controller="Entrega"
                          asp-action="RegistrarRepeticionManual"
                          method="post"
                          class="formulario-repeticion d-inline">
                        @Html.AntiForgeryToken()

                        <input name="idEntrega"
                               value="@idEntregaRepeticion.Value"
                               type="hidden" />

                        <input name="identificacion"
                               value="@identificacionBusqueda"
                               type="hidden" />

                        @if (Model.IdMenuSeleccionado.HasValue)
                        {
                            <input name="idMenu"
                                   value="@Model.IdMenuSeleccionado.Value"
                                   type="hidden" />
                        }

                        <button type="submit"
                                class="btn btn-warning">
                            Confirmar repetición número @(cantidadRepeticiones + 1)
                        </button>
                    </form>

                    <a asp-controller="Entrega"
                       asp-action="Registrar"
                       asp-route-identificacion="@identificacionBusqueda"
                       asp-route-idMenu="@Model.IdMenuSeleccionado"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                }
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Registrar con código de barras</strong>
        </div>

        <div class="card-body">
            @if (Model.MenusDisponibles.Any())
            {
                <form asp-controller="Entrega"
                      asp-action="RegistrarCodigoBarras"
                      method="post"
                      id="formularioCodigoBarras">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="IdMenuSeleccionado"
                               class="form-label">
                        </label>

                        <select name="idMenu"
                                id="selectorMenu"
                                class="form-select"
                                required>
                            <option value="">
                                Seleccione el menú
                            </option>

                            @foreach (var menu in Model.MenusDisponibles)
                            {
                                if (Model.IdMenuSeleccionado == menu.Id)
                                {
                                    <option value="@menu.Id"
                                            selected>
                                        @menu.Nombre
                                    </option>
                                }
                                else
                                {
                                    <option value="@menu.Id">
                                        @menu.Nombre
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label asp-for="CodigoBarras"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <input name="codigoBarras"
                                   id="campoCodigoBarras"
                                   class="form-control"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="Escanee el código de barras"
                                   autofocus />

                            <button type="submit"
                                    class="btn btn-success">
                                Registrar
                            </button>
                        </div>

                        <div class="form-text">
                            Seleccione el menú y escanee el código. El lector enviará el código automáticamente.
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No existen menús publicados y activos para hoy.
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Registrar manualmente por cédula</strong>
        </div>

        <div class="card-body">
            <form asp-controller="Entrega"
                  asp-action="Registrar"
                  method="get">
                @if (Model.IdMenuSeleccionado.HasValue)
                {
                    <input name="idMenu"
                           value="@Model.IdMenuSeleccionado.Value"
                           type="hidden" />
                }

                <label asp-for="Identificacion"
                       class="form-label">
                </label>

                <div class="input-group">
                    <input asp-for="Identificacion"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Digite la cédula" />

                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.BusquedaRealizada)
    {
        if (string.IsNullOrWhiteSpace(Model.NombreUsuario))
        {
            <div class="alert alert-warning">
                @(Model.MensajeBusqueda ??
                    "No se encontró el usuario.")
            </div>
        }
        else
        {
            <h2 class="h5 mb-3">
                Solicitudes de @Model.NombreUsuario
            </h2>

            @if (Model.Solicitudes.Any())
            {
                <div class="row g-3">
                    @foreach (var solicitud in Model.Solicitudes)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h3 class="h5">
                                        @solicitud.TipoComida
                                    </h3>

                                    <p>
                                        @solicitud.DescripcionMenu
                                    </p>

                                    <div class="text-muted small mb-3">
                                        Solicitud:
                                        @solicitud.FechaHoraSolicitud.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    @if (!solicitud.Entregada)
                                    {
                                        <div class="alert alert-info py-2">
                                            Esta comida se encuentra pendiente de entrega.
                                        </div>

                                        <form asp-controller="Entrega"
                                              asp-action="Registrar"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input name="idSolicitud"
                                                   value="@solicitud.IdSolicitud"
                                                   type="hidden" />

                                            <input name="identificacion"
                                                   value="@Model.Identificacion"
                                                   type="hidden" />

                                            @if (Model.IdMenuSeleccionado.HasValue)
                                            {
                                                <input name="idMenu"
                                                       value="@Model.IdMenuSeleccionado.Value"
                                                       type="hidden" />
                                            }

                                            <button type="submit"
                                                    class="btn btn-success"
                                                    onclick="return confirm('¿Confirma la entrega?');">
                                                Registrar entrega
                                            </button>
                                        </form>
                                    }
                                    else if (solicitud.IdEntrega.HasValue)
                                    {
                                        <div class="alert alert-info py-2">
                                            <div>
                                                Esta comida ya fue entregada.
                                            </div>

                                            <div>
                                                Repeticiones registradas:
                                                <strong>@solicitud.CantidadRepeticiones</strong>
                                            </div>
                                        </div>

                                        <form asp-controller="Entrega"
                                              asp-action="PrepararRepeticionManual"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input name="idEntrega"
                                                   value="@solicitud.IdEntrega.Value"
                                                   type="hidden" />

                                            <input name="identificacion"
                                                   value="@Model.Identificacion"
                                                   type="hidden" />

                                            @if (Model.IdMenuSeleccionado.HasValue)
                                            {
                                                <input name="idMenu"
                                                       value="@Model.IdMenuSeleccionado.Value"
                                                       type="hidden" />
                                            }

                                            <button type="submit"
                                                    class="btn btn-warning">
                                                Solicitar repetición número @(solicitud.CantidadRepeticiones + 1)
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    @(Model.MensajeBusqueda ??
                        "El usuario no tiene solicitudes activas para hoy.")
                </div>
            }
        }
    }
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const hayConfirmacion =
        @(confirmarRepeticion ? "true" : "false");

            const campoCodigo =
                document.getElementById("campoCodigoBarras");

            const selectorMenu =
                document.getElementById("selectorMenu");

            const formularioCodigo =
                document.getElementById("formularioCodigoBarras");

            if (campoCodigo && selectorMenu) {
                if (selectorMenu.value && !hayConfirmacion) {
                    campoCodigo.focus();
                }

                selectorMenu.addEventListener("change", function () {
                    if (selectorMenu.value) {
                        campoCodigo.focus();
                    }
                });
            }

            if (formularioCodigo) {
                formularioCodigo.addEventListener("submit", function () {
                    const boton = formularioCodigo.querySelector(
                        "button[type='submit']"
                    );

                    if (boton) {
                        boton.disabled = true;
                        boton.textContent = "Registrando...";
                    }
                });
            }

            document.querySelectorAll(".formulario-repeticion")
                .forEach(function (formulario) {
                    formulario.addEventListener("submit", function () {
                        const boton = formulario.querySelector(
                            "button[type='submit']"
                        );

                        if (boton) {
                            boton.disabled = true;
                            boton.textContent = "Registrando...";
                        }
                    });
                });
        });
    </script>
}