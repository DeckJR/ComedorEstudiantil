@model ComedorEstudiantil.Application.DTOs.RegistroEntregaDTO

@{
    ViewData["Title"] = "Registrar entrega";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Registrar entrega</h1>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <strong>Entrega registrada.</strong>
            <div>@TempData["MensajeExito"]</div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show"
             role="alert">
            <strong>No se pudo registrar la entrega.</strong>
            <div>@TempData["MensajeError"]</div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Registrar con código de barras</strong>
        </div>

        <div class="card-body">
            @if (Model.MenusDisponibles.Any())
            {
                <form asp-controller="Entrega"
                      asp-action="RegistrarCodigoBarras"
                      method="post"
                      id="formularioCodigoBarras">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="IdMenuSeleccionado"
                               class="form-label">
                        </label>

                        <select name="idMenu"
                                id="selectorMenu"
                                class="form-select"
                                required>
                            <option value="">
                                Seleccione el menú
                            </option>

                            @foreach (var menu in Model.MenusDisponibles)
                            {
                                <option value="@menu.Id"
                                        selected="@(Model.IdMenuSeleccionado == menu.Id)">
                                    @menu.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label asp-for="CodigoBarras"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <input name="codigoBarras"
                                   id="campoCodigoBarras"
                                   class="form-control"
                                   maxlength="50"
                                   autocomplete="off"
                                   placeholder="Escanee el código"
                                   autofocus />

                            <button type="submit"
                                    class="btn btn-success">
                                Registrar
                            </button>
                        </div>

                        <div class="form-text">
                            Seleccione el menú y escanee el código. El lector enviará la información automáticamente.
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No existen menús publicados y activos para hoy.
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Registrar manualmente por cédula</strong>
        </div>

        <div class="card-body">
            <form asp-controller="Entrega"
                  asp-action="Registrar"
                  method="get">
                @if (Model.IdMenuSeleccionado.HasValue)
                {
                    <input name="idMenu"
                           value="@Model.IdMenuSeleccionado"
                           type="hidden" />
                }

                <label asp-for="Identificacion"
                       class="form-label">
                </label>

                <div class="input-group">
                    <input asp-for="Identificacion"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Digite la cédula" />

                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.BusquedaRealizada)
    {
        if (string.IsNullOrWhiteSpace(Model.NombreUsuario))
        {
            <div class="alert alert-warning">
                @(Model.MensajeBusqueda ?? "No se encontró el usuario.")
            </div>
        }
        else
        {
            <h2 class="h5 mb-3">
                Solicitudes de @Model.NombreUsuario
            </h2>

            @if (Model.Solicitudes.Any())
            {
                <div class="row g-3">
                    @foreach (var solicitud in Model.Solicitudes)
                    {
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h3 class="h5">
                                        @solicitud.TipoComida
                                    </h3>

                                    <p>
                                        @solicitud.DescripcionMenu
                                    </p>

                                    <div class="text-muted small mb-3">
                                        Solicitud:
                                        @solicitud.FechaHoraSolicitud.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    <form asp-controller="Entrega"
                                          asp-action="Registrar"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input name="idSolicitud"
                                               value="@solicitud.IdSolicitud"
                                               type="hidden" />

                                        <input name="identificacion"
                                               value="@Model.Identificacion"
                                               type="hidden" />

                                        <button type="submit"
                                                class="btn btn-success"
                                                onclick="return confirm('¿Confirma la entrega?');">
                                            Registrar entrega
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    @Model.MensajeBusqueda
                </div>
            }
        }
    }
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selectorMenu = document.getElementById("selectorMenu");
            const campoCodigo = document.getElementById("campoCodigoBarras");

            if (!selectorMenu || !campoCodigo) {
                return;
            }

            function enfocarCodigo() {
                if (selectorMenu.value) {
                    campoCodigo.focus();
                }
            }

            selectorMenu.addEventListener("change", enfocarCodigo);
            enfocarCodigo();
        });
    </script>
}