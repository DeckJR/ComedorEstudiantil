@model IEnumerable<ComedorEstudiantil.Application.DTOs.EntregaListaDTO>

@{
    ViewData["Title"] = "Entregas del día";

    int cantidadEntregas = Model.Count();
    int cantidadRepeticiones = Model.Sum(
        entrega => entrega.CantidadRepeticiones);
    int cantidadPlatos = Model.Sum(
        entrega => entrega.CantidadPlatosConsumidos);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="h3 mb-0">Entregas del día</h1>

        <a asp-controller="Entrega"
           asp-action="Registrar"
           class="btn btn-primary">
            Registrar entrega
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted">
                        Entregas iniciales
                    </div>

                    <div class="display-6 fw-semibold">
                        @cantidadEntregas
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="text-muted">
                        Repeticiones
                    </div>

                    <div class="display-6 fw-semibold">
                        @cantidadRepeticiones
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="text-muted">
                        Total de platos
                    </div>

                    <div class="display-6 fw-semibold text-primary">
                        @cantidadPlatos
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Identificación</th>
                            <th>Persona</th>
                            <th>Tipo</th>
                            <th>Menú</th>
                            <th>Registrado por</th>
                            <th>Método</th>
                            <th class="text-center">Repeticiones</th>
                            <th class="text-center">Platos consumidos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entrega in Model)
                        {
                            <tr>
                                <td>
                                    @entrega.FechaHoraEntrega.ToString("HH:mm")
                                </td>
                                <td>@entrega.Identificacion</td>
                                <td>@entrega.NombreUsuario</td>
                                <td>@entrega.TipoComida</td>
                                <td>@entrega.DescripcionMenu</td>
                                <td>@entrega.EntregadoPor</td>
                                <td>@entrega.MetodoEntrega</td>
                                <td class="text-center">
                                    @if (entrega.CantidadRepeticiones > 0)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @entrega.CantidadRepeticiones
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            0
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">
                                        @entrega.CantidadPlatosConsumidos
                                    </span>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center text-muted py-4">
                                    No se han registrado entregas hoy.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>