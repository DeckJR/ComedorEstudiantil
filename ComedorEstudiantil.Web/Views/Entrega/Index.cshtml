@model IEnumerable<ComedorEstudiantil.Application.DTOs.EntregaListaDTO>

@{
    ViewData["Title"] = "Entregas del día";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Entregas del día</h1>

        <a asp-controller="Entrega"
           asp-action="Registrar"
           class="btn btn-primary">
            Registrar entrega
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Identificación</th>
                            <th>Persona</th>
                            <th>Tipo</th>
                            <th>Menú</th>
                            <th>Registrado por</th>
                            <th>Método</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var entrega in Model)
                        {
                            <tr>
                                <td>
                                    @entrega.FechaHoraEntrega.ToString("HH:mm")
                                </td>
                                <td>@entrega.Identificacion</td>
                                <td>@entrega.NombreUsuario</td>
                                <td>@entrega.TipoComida</td>
                                <td>@entrega.DescripcionMenu</td>
                                <td>@entrega.EntregadoPor</td>
                                <td>@entrega.MetodoEntrega</td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No se han registrado entregas hoy.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>