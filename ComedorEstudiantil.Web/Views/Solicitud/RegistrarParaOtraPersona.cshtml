@model ComedorEstudiantil.Application.DTOs.SolicitudAjenaDTO

@{
    ViewData["Title"] = "Solicitud manual";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h1 class="h4 mb-0">
                        Solicitar para otra persona
                    </h1>
                </div>

                <div class="card-body">
                    <p>
                        <strong>Fecha:</strong>
                        @Model.FechaMenu.ToString("dd/MM/yyyy")
                    </p>

                    <p>
                        <strong>Tipo:</strong>
                        @Model.TipoComida
                    </p>

                    <p>
                        <strong>Menú:</strong>
                        @Model.DescripcionMenu
                    </p>

                    <form asp-controller="Solicitud"
                          asp-action="RegistrarParaOtraPersona"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="IdMenu" type="hidden" />
                        <input asp-for="FechaMenu" type="hidden" />
                        <input asp-for="TipoComida" type="hidden" />
                        <input asp-for="DescripcionMenu" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Identificacion"
                                   class="form-label">
                            </label>

                            <input asp-for="Identificacion"
                                   class="form-control"
                                   autofocus />

                            <span asp-validation-for="Identificacion"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Registrar solicitud
                            </button>

                            <a asp-controller="Menu"
                               asp-action="Index"
                               asp-route-fecha="@Model.FechaMenu.ToString("yyyy-MM-dd")"
                               class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}