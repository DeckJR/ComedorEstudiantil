@model IEnumerable<ComedorEstudiantil.Application.DTOs.SolicitudListaDTO>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Mis solicitudes</h1>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Menú</th>
                            <th>Solicitud</th>
                            <th>Estado</th>
                            <th>Entrega</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model)
                        {
                            <tr>
                                <td>
                                    @solicitud.FechaMenu.ToString("dd/MM/yyyy")
                                </td>
                                <td>@solicitud.TipoComida</td>
                                <td>@solicitud.DescripcionMenu</td>
                                <td>
                                    @solicitud.FechaHoraSolicitud.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge @(solicitud.Activa ? "bg-success" : "bg-secondary")">
                                        @solicitud.Estado
                                    </span>
                                </td>
                                <td>
                                    @if (solicitud.Entregada)
                                    {
                                        <span class="badge bg-primary">
                                            Entregada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pendiente
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (solicitud.PuedeCancelar)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCancelarSolicitud"
                                                data-id-solicitud="@solicitud.IdSolicitud"
                                                data-tipo-comida="@solicitud.TipoComida"
                                                data-descripcion="@solicitud.DescripcionMenu">
                                            Cancelar
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin acciones
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No tiene solicitudes registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalCancelarSolicitud"
     tabindex="-1"
     aria-labelledby="tituloModalCancelarSolicitud"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Solicitud"
                  asp-action="Cancelar"
                  method="post">
                @Html.AntiForgeryToken()

                <input id="idSolicitudCancelar"
                       name="idSolicitud"
                       type="hidden" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5"
                        id="tituloModalCancelarSolicitud">
                        Cancelar solicitud
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        ¿Desea cancelar esta solicitud?
                    </p>

                    <div class="alert alert-warning mb-0">
                        <div>
                            <strong>Tipo de comida:</strong>
                            <span id="tipoComidaCancelar"></span>
                        </div>

                        <div>
                            <strong>Menú:</strong>
                            <span id="descripcionMenuCancelar"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Volver
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Confirmar cancelación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("modalCancelarSolicitud");
            const campoIdSolicitud = document.getElementById("idSolicitudCancelar");
            const campoTipoComida = document.getElementById("tipoComidaCancelar");
            const campoDescripcion = document.getElementById("descripcionMenuCancelar");

            modal.addEventListener("show.bs.modal", function (event) {
                const boton = event.relatedTarget;

                campoIdSolicitud.value = boton.dataset.idSolicitud;
                campoTipoComida.textContent = boton.dataset.tipoComida;
                campoDescripcion.textContent = boton.dataset.descripcion;
            });
        });
    </script>
}