@model IEnumerable<ComedorEstudiantil.Application.DTOs.SolicitudListaDTO>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="container py-4">
    <h1 class="h3 mb-4">Mis solicitudes</h1>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Menú</th>
                            <th>Solicitud</th>
                            <th>Estado</th>
                            <th>Entrega</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var solicitud in Model)
                        {
                            <tr>
                                <td>@solicitud.FechaMenu.ToString("dd/MM/yyyy")</td>
                                <td>@solicitud.TipoComida</td>
                                <td>@solicitud.DescripcionMenu</td>
                                <td>@solicitud.FechaHoraSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(solicitud.Activa ? "bg-success" : "bg-secondary")">
                                        @solicitud.Estado
                                    </span>
                                </td>
                                <td>
                                    @(solicitud.Entregada ? "Entregada" : "Pendiente")
                                </td>
                                <td class="text-end">
                                    @if (solicitud.PuedeCancelar)
                                    {
                                        <form asp-controller="Solicitud"
                                              asp-action="Cancelar"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input name="idSolicitud"
                                                   value="@solicitud.IdSolicitud"
                                                   type="hidden" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('¿Desea cancelar esta solicitud?');">
                                                Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No tiene solicitudes registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>