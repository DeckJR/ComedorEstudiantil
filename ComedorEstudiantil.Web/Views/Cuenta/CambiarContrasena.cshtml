@model ComedorEstudiantil.Application.DTOs.CambiarContrasenaDTO

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            @if (Model.CambioObligatorio)
            {
                <div class="alert alert-warning">
                    La contraseña utilizada es temporal. Debe establecer una contraseña personal antes de continuar.
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header">
                    <h1 class="h4 mb-0">Cambiar contraseña</h1>
                </div>

                <div class="card-body">
                    <form asp-controller="Cuenta"
                          asp-action="CambiarContrasena"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="CambioObligatorio"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContrasenaActual"
                                   class="form-label">
                            </label>

                            <input asp-for="ContrasenaActual"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="ContrasenaActual"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NuevaContrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="NuevaContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NuevaContrasena"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmarContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmarContrasena"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Guardar contraseña
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}