@model ComedorEstudiantil.Application.DTOs.MenuPublicoDTO

@{
    ViewData["Title"] = "Menú";
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="h3">Menú del comedor</h1>
        <p class="text-muted">
            Consulte y solicite los alimentos disponibles.
        </p>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <form asp-controller="Menu"
          asp-action="Index"
          method="get"
          class="row justify-content-center mb-4">
        <div class="col-md-5">
            <label for="fecha" class="form-label">
                Fecha
            </label>

            <div class="input-group">
                <input id="fecha"
                       name="fecha"
                       type="date"
                       class="form-control"
                       value="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")" />

                <button type="submit"
                        class="btn btn-primary">
                    Consultar
                </button>
            </div>
        </div>
    </form>

    @if (Model.Menus.Any())
    {
        <div class="row g-4">
            @foreach (var menu in Model.Menus)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h2 class="h5 mb-0">
                                @menu.TipoComida
                            </h2>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <p style="white-space: pre-line;">
                                @menu.Descripcion
                            </p>

                            @if (!string.IsNullOrWhiteSpace(menu.Actividad))
                            {
                                <div class="alert alert-info py-2">
                                    Actividad: @menu.Actividad
                                </div>
                            }

                            <div class="text-muted small mb-3">
                                Hora límite:
                                @menu.HoraLimiteMarcar.ToString("HH:mm")
                            </div>

                            <div class="mt-auto">
                                @if (User.Identity?.IsAuthenticated != true)
                                {
                                    <a asp-controller="Cuenta"
                                       asp-action="IniciarSesion"
                                       class="btn btn-primary w-100">
                                        Iniciar sesión para solicitar
                                    </a>
                                }
                                else if (menu.SolicitudActiva)
                                {
                                    <div class="alert alert-success py-2">
                                        Solicitud registrada
                                    </div>

                                    @if (menu.PuedeSolicitar &&
                                   menu.IdSolicitud.HasValue)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-danger w-100"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCancelarSolicitud"
                                                data-id-solicitud="@menu.IdSolicitud"
                                                data-tipo-comida="@menu.TipoComida"
                                                data-descripcion="@menu.Descripcion">
                                            Cancelar solicitud
                                        </button>
                                    }
                                }
                                else if (menu.PuedeSolicitar)
                                {
                                    <form asp-controller="Solicitud"
                                          asp-action="Solicitar"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input name="idMenu"
                                               value="@menu.IdMenu"
                                               type="hidden" />

                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            Solicitar comida
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-secondary py-2">
                                        @menu.MensajeDisponibilidad
                                    </div>
                                }

                                @if (User.IsInRole("Cocina") ||
                               User.IsInRole("Direccion") ||
                               User.IsInRole("Director") ||
                               User.IsInRole("Administrador"))
                                {
                                    <a asp-controller="Solicitud"
                                       asp-action="RegistrarParaOtraPersona"
                                       asp-route-idMenu="@menu.IdMenu"
                                       class="btn btn-outline-secondary w-100 mt-2">
                                        Solicitar para otra persona
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No existen menús publicados para la fecha seleccionada.
        </div>
    }
</div>

<div class="modal fade"
     id="modalCancelarSolicitud"
     tabindex="-1"
     aria-labelledby="tituloModalCancelarSolicitud"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Solicitud"
                  asp-action="Cancelar"
                  method="post">
                @Html.AntiForgeryToken()

                <input id="idSolicitudCancelar"
                       name="idSolicitud"
                       type="hidden" />

                <input name="returnUrl"
                       value="@returnUrl"
                       type="hidden" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5"
                        id="tituloModalCancelarSolicitud">
                        Cancelar solicitud
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        ¿Desea cancelar esta solicitud?
                    </p>

                    <div class="alert alert-warning mb-0">
                        <div>
                            <strong>Tipo de comida:</strong>
                            <span id="tipoComidaCancelar"></span>
                        </div>

                        <div>
                            <strong>Menú:</strong>
                            <span id="descripcionMenuCancelar"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Volver
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Confirmar cancelación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("modalCancelarSolicitud");
            const campoIdSolicitud = document.getElementById("idSolicitudCancelar");
            const campoTipoComida = document.getElementById("tipoComidaCancelar");
            const campoDescripcion = document.getElementById("descripcionMenuCancelar");

            modal.addEventListener("show.bs.modal", function (event) {
                const boton = event.relatedTarget;

                campoIdSolicitud.value = boton.dataset.idSolicitud;
                campoTipoComida.textContent = boton.dataset.tipoComida;
                campoDescripcion.textContent = boton.dataset.descripcion;
            });
        });
    </script>
}