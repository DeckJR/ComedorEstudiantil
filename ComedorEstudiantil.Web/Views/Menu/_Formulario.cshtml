@model ComedorEstudiantil.Application.DTOs.MenuFormularioDTO

<input asp-for="IdMenu" type="hidden" />

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Fecha"
               class="form-label">
        </label>

        <input asp-for="Fecha"
               class="form-control"
               type="date" />

        <span asp-validation-for="Fecha"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="IdTipoComida"
               class="form-label">
        </label>

        <select asp-for="IdTipoComida"
                class="form-select">
            <option value="">Seleccione un tipo</option>

            @foreach (var tipo in Model.TiposComida)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
            }
        </select>

        <span asp-validation-for="IdTipoComida"
              class="text-danger">
        </span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Descripcion"
           class="form-label">
    </label>

    <textarea asp-for="Descripcion"
              class="form-control"
              rows="7">
    </textarea>

    <span asp-validation-for="Descripcion"
          class="text-danger">
    </span>
</div>

<div class="mb-3">
    <label asp-for="IdActividad"
           class="form-label">
    </label>

    <select asp-for="IdActividad"
            class="form-select">
        <option value="">Sin actividad especial</option>

        @foreach (var actividad in Model.Actividades)
        {
            <option value="@actividad.Id">@actividad.Nombre</option>
        }
    </select>

    <span asp-validation-for="IdActividad"
          class="text-danger">
    </span>

    <div class="form-text">
        La actividad debe corresponder a la misma fecha del menú.
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="Publicado"
           class="form-check-input" />

    <label asp-for="Publicado"
           class="form-check-label">
        Publicar menú
    </label>
</div>