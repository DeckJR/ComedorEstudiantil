@model IEnumerable<ComedorEstudiantil.Application.DTOs.MenuListaDTO>

@{
    ViewData["Title"] = "Administrar menús";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Menús</h1>
            <p class="text-muted mb-0">
                Administración y publicación de menús.
            </p>
        </div>

        <a asp-controller="Menu"
           asp-action="Crear"
           class="btn btn-primary">
            Crear menú
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Actividad</th>
                            <th>Creado por</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var menu in Model)
                        {
                            <tr>
                                <td>@menu.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@menu.TipoComida</td>
                                <td style="white-space: pre-line;">@menu.Descripcion</td>
                                <td>@(menu.Actividad ?? "Ninguna")</td>
                                <td>@menu.CreadoPor</td>
                                <td>
                                    @if (menu.Publicado)
                                    {
                                        <span class="badge bg-success">
                                            Publicado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            No publicado
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Menu"
                                           asp-action="Editar"
                                           asp-route-id="@menu.IdMenu"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-controller="Menu"
                                              asp-action="CambiarPublicacion"
                                              asp-route-id="@menu.IdMenu"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                @(menu.Publicado ? "Despublicar" : "Publicar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    No existen menús registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>