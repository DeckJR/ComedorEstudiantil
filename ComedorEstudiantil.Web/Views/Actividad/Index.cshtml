@model IEnumerable<ComedorEstudiantil.Application.DTOs.ActividadDTO>

@{
    ViewData["Title"] = "Actividades";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Actividades</h1>
            <p class="text-muted mb-0">
                Administración de actividades especiales del colegio.
            </p>
        </div>

        <a asp-controller="Actividad"
           asp-action="Crear"
           class="btn btn-primary">
            Crear actividad
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var actividad in Model)
                        {
                            <tr>
                                <td>@actividad.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@actividad.Nombre</td>
                                <td>@(actividad.Descripcion ?? "Sin descripción")</td>
                                <td>
                                    @if (actividad.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactiva
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Actividad"
                                           asp-action="Editar"
                                           asp-route-id="@actividad.IdActividad"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-controller="Actividad"
                                              asp-action="CambiarEstado"
                                              asp-route-id="@actividad.IdActividad"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            @if (actividad.Activo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Desea desactivar esta actividad?');">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        onclick="return confirm('¿Desea activar esta actividad?');">
                                                    Activar
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No existen actividades registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>