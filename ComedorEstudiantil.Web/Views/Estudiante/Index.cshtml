@model IEnumerable<ComedorEstudiantil.Application.DTOs.EstudianteListaDTO>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="container py-4">
    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">
                Estudiantes
            </h1>

            <p class="text-muted mb-0">
                Administración de estudiantes
                del comedor.
            </p>
        </div>

        <a asp-controller="Estudiante"
           asp-action="Crear"
           class="btn btn-primary">
            Crear estudiante
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped
                              table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Beneficio</th>
                            <th>Sección</th>
                            <th>Año de ingreso</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var estudiante in Model)
                        {
                            <tr>
                                <td>
                                    @estudiante.Identificacion
                                </td>

                                <td>
                                    @estudiante.NombreCompleto
                                </td>

                                <td>
                                    @estudiante.Correo
                                </td>

                                <td>
                                    @estudiante.TipoBeneficiario
                                </td>

                                <td>
                                    @estudiante.GradoSeccion
                                </td>

                                <td>
                                    @estudiante.AnioIngreso
                                </td>

                                <td>
                                    @if (estudiante.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap
                                                justify-content-end
                                                gap-2">
                                        <a asp-controller="Estudiante"
                                           asp-action="Editar"
                                           asp-route-id="@estudiante.IdEstudiante"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Estudiante"
                                           asp-action="CodigoBarras"
                                           asp-route-id="@estudiante.IdEstudiante"
                                           class="btn btn-sm
                                                  btn-outline-dark">
                                            Código
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm @(estudiante.Activo
                                                    ? "btn-outline-danger"
                                                    : "btn-outline-success")"
                                                data-bs-toggle="modal"
                                                data-bs-target="#estado-@estudiante.IdEstudiante">
                                            @(estudiante.Activo
                                                ? "Desactivar"
                                                : "Activar")
                                        </button>
                                    </div>

                                    <div class="modal fade"
                                         id="estado-@estudiante.IdEstudiante"
                                         tabindex="-1"
                                         aria-hidden="true">
                                        <div class="modal-dialog
                                                    modal-dialog-centered">
                                            <div class="modal-content
                                                        text-start">
                                                <div class="modal-header">
                                                    <h2 class="modal-title fs-5">
                                                        @(estudiante.Activo
                                                            ? "Desactivar estudiante"
                                                            : "Activar estudiante")
                                                    </h2>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal"
                                                            aria-label="Cerrar">
                                                    </button>
                                                </div>

                                                <div class="modal-body">
                                                    @if (estudiante.Activo)
                                                    {
                                                        <p class="mb-0">
                                                            ¿Desea desactivar a
                                                            <strong>
                                                                @estudiante.NombreCompleto
                                                            </strong>?
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        <p class="mb-0">
                                                            ¿Desea activar a
                                                            <strong>
                                                                @estudiante.NombreCompleto
                                                            </strong>?
                                                        </p>
                                                    }
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button"
                                                            class="btn
                                                                   btn-secondary"
                                                            data-bs-dismiss="modal">
                                                        Volver
                                                    </button>

                                                    <form asp-controller="Estudiante"
                                                          asp-action="CambiarEstado"
                                                          method="post">
                                                        @Html.AntiForgeryToken()

                                                        <input name="id"
                                                               value="@estudiante.IdEstudiante"
                                                               type="hidden" />

                                                        <button type="submit"
                                                                class="btn @(estudiante.Activo
                                                                    ? "btn-danger"
                                                                    : "btn-success")">
                                                            Confirmar
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center
                                           text-muted py-4">
                                    No existen estudiantes
                                    registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>