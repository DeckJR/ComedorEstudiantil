@model IEnumerable<ComedorEstudiantil.Application.DTOs.EstudianteListaDTO>

@{
    ViewData["Title"] = "Estudiantes";

    bool incluirArchivados =
        ViewData["IncluirArchivados"] is bool valor &&
        valor;
}

<div class="container py-4">
    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                Estudiantes
            </h1>

            <p class="text-muted mb-0">
                Administración de estudiantes del comedor.
            </p>
        </div>

        <a asp-controller="Estudiante"
           asp-action="Crear"
           class="btn btn-primary">
            Crear estudiante
        </a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success
                    alert-dismissible fade show"
             role="alert">
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger
                    alert-dismissible fade show"
             role="alert">
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Estudiante"
                  asp-action="Index"
                  method="get">
                <div class="form-check form-switch">
                    @if (incluirArchivados)
                    {
                        <input id="incluirArchivados"
                               name="incluirArchivados"
                               value="true"
                               type="checkbox"
                               class="form-check-input"
                               checked
                               onchange="this.form.submit();" />
                    }
                    else
                    {
                        <input id="incluirArchivados"
                               name="incluirArchivados"
                               value="true"
                               type="checkbox"
                               class="form-check-input"
                               onchange="this.form.submit();" />
                    }

                    <label for="incluirArchivados"
                           class="form-check-label">
                        Mostrar también estudiantes archivados
                    </label>
                </div>

                <div class="form-text">
                    Los estudiantes archivados dejan de aparecer
                    en el listado principal y no pueden utilizar
                    su cuenta.
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex
                    justify-content-between
                    align-items-center">
            <strong>
                Estudiantes registrados
            </strong>

            <span class="badge bg-secondary">
                @Model.Count()
            </span>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped
                              table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Beneficio</th>
                            <th>Sección</th>
                            <th>Año de ingreso</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var estudiante in Model)
                        {
                            <tr class="@(!estudiante.Activo
                                ? "table-secondary"
                                : string.Empty)">
                                <td>
                                    @estudiante.Identificacion
                                </td>

                                <td>
                                    @estudiante.NombreCompleto
                                </td>

                                <td>
                                    @estudiante.Correo
                                </td>

                                <td>
                                    @estudiante.TipoBeneficiario
                                </td>

                                <td>
                                    @estudiante.GradoSeccion
                                </td>

                                <td>
                                    @estudiante.AnioIngreso
                                </td>

                                <td>
                                    @if (estudiante.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Archivado
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-wrap
                                                justify-content-end
                                                gap-2">
                                        <a asp-controller="Estudiante"
                                           asp-action="Editar"
                                           asp-route-id="@estudiante.IdEstudiante"
                                           class="btn btn-sm
                                                  btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Estudiante"
                                           asp-action="CodigoBarras"
                                           asp-route-id="@estudiante.IdEstudiante"
                                           class="btn btn-sm
                                                  btn-outline-dark">
                                            Código
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm @(estudiante.Activo
                                                    ? "btn-outline-danger"
                                                    : "btn-outline-success")"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEstadoEstudiante"
                                                data-id="@estudiante.IdEstudiante"
                                                data-nombre="@estudiante.NombreCompleto"
                                                data-activo="@estudiante.Activo.ToString().ToLowerInvariant()">
                                            @(estudiante.Activo
                                                ? "Archivar"
                                                : "Restaurar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center
                                           text-muted py-4">
                                    @if (incluirArchivados)
                                    {
                                        <span>
                                            No existen estudiantes registrados.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            No existen estudiantes activos.
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalEstadoEstudiante"
     tabindex="-1"
     aria-labelledby="tituloModalEstadoEstudiante"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Estudiante"
                  asp-action="CambiarEstado"
                  method="post">
                @Html.AntiForgeryToken()

                <input id="idEstudianteEstado"
                       name="id"
                       type="hidden" />

                <input name="incluirArchivados"
                       value="@incluirArchivados.ToString().ToLowerInvariant()"
                       type="hidden" />

                />

                <div class="modal-header">
                    <h2 class="modal-title fs-5"
                        id="tituloModalEstadoEstudiante">
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <p id="mensajeModalEstadoEstudiante"
                       class="mb-0">
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Volver
                    </button>

                    <button id="botonConfirmarEstadoEstudiante"
                            type="submit"
                            class="btn">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal =
                document.getElementById(
                    "modalEstadoEstudiante");

            const campoId =
                document.getElementById(
                    "idEstudianteEstado");

            const titulo =
                document.getElementById(
                    "tituloModalEstadoEstudiante");

            const mensaje =
                document.getElementById(
                    "mensajeModalEstadoEstudiante");

            const botonConfirmar =
                document.getElementById(
                    "botonConfirmarEstadoEstudiante");

            modal.addEventListener(
                "show.bs.modal",
                function (event) {
                    const boton = event.relatedTarget;
                    const activo =
                        boton.dataset.activo === "true";

                    campoId.value =
                        boton.dataset.id;

                    if (activo) {
                        titulo.textContent =
                            "Archivar estudiante";

                        mensaje.textContent =
                            "¿Desea archivar a " +
                            boton.dataset.nombre +
                            "? El estudiante dejará de aparecer en el listado principal y no podrá utilizar su cuenta.";

                        botonConfirmar.textContent =
                            "Archivar";

                        botonConfirmar.className =
                            "btn btn-danger";
                    } else {
                        titulo.textContent =
                            "Restaurar estudiante";

                        mensaje.textContent =
                            "¿Desea restaurar a " +
                            boton.dataset.nombre +
                            "? El estudiante podrá volver a utilizar su cuenta.";

                        botonConfirmar.textContent =
                            "Restaurar";

                        botonConfirmar.className =
                            "btn btn-success";
                    }
                });
        });
    </script>
}