@model ComedorEstudiantil.Application.DTOs.EstudianteFormularioDTO

@{
    bool esCreacion = Model.IdEstudiante == 0;
}

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>

<input asp-for="IdUsuario"
       type="hidden" />

<input asp-for="IdEstudiante"
       type="hidden" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre"
               class="form-label">
        </label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="Apellidos"
               class="form-label">
        </label>

        <input asp-for="Apellidos"
               class="form-control" />

        <span asp-validation-for="Apellidos"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="Identificacion"
               class="form-label">
        </label>

        <input asp-for="Identificacion"
               class="form-control" />

        <span asp-validation-for="Identificacion"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="Correo"
               class="form-label">
        </label>

        <input asp-for="Correo"
               class="form-control" />

        <span asp-validation-for="Correo"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdTipoBeneficiario"
               class="form-label">
        </label>

        <select asp-for="IdTipoBeneficiario"
                class="form-select">
            <option value="">
                Seleccione un tipo
            </option>

            @foreach (var tipo in
            Model.TiposBeneficiario)
            {
                <option value="@tipo.Id">
                    @tipo.Nombre
                </option>
            }
        </select>

        <span asp-validation-for="IdTipoBeneficiario"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdGradoSeccion"
               class="form-label">
        </label>

        <select asp-for="IdGradoSeccion"
                class="form-select">
            <option value="">
                Sin asignar
            </option>

            @foreach (var grado in
            Model.GradosSecciones)
            {
                <option value="@grado.Id">
                    @grado.Nombre
                </option>
            }
        </select>

        <span asp-validation-for="IdGradoSeccion"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="AnioIngreso"
               class="form-label">
        </label>

        <input asp-for="AnioIngreso"
               type="number"
               min="2000"
               max="2100"
               class="form-control" />

        <span asp-validation-for="AnioIngreso"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <div class="form-check mt-md-4 pt-md-2">
            <input asp-for="Activo"
                   class="form-check-input" />

            <label asp-for="Activo"
                   class="form-check-label">
                Estudiante activo
            </label>
        </div>
    </div>

    <div class="col-md-6">
        <label asp-for="Contrasena"
               class="form-label">
        </label>

        <input asp-for="Contrasena"
               class="form-control" />

        @if (esCreacion)
        {
            <div class="form-text">
                La contraseña es obligatoria y debe
                contener al menos 8 caracteres.
            </div>
        }
        else
        {
            <div class="form-text">
                Déjela vacía para conservar la
                contraseña actual.
            </div>
        }

        <span asp-validation-for="Contrasena"
              class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="ConfirmarContrasena"
               class="form-label">
        </label>

        <input asp-for="ConfirmarContrasena"
               class="form-control" />

        <span asp-validation-for="ConfirmarContrasena"
              class="text-danger">
        </span>
    </div>
</div>